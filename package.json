{
  "name": "pi-literature-review",
  "version": "0.1.0",
  "description": "Local, login-free literature review for the Pi coding agent: multi-source search (arXiv, Crossref, OpenAlex, Semantic Scholar) with HTTP-verified identifiers, legal open-access PDF selection, and grounded synthesis over local PDFs with page-exact citations. No LLM in the citation path.",
  "type": "module",
  "license": "MIT",
  "author": "Florian Lindenberger",
  "homepage": "https://github.com/flindenberger/pi-literature-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flindenberger/pi-literature-review.git"
  },
  "bugs": {
    "url": "https://github.com/flindenberger/pi-literature-review/issues"
  },
  "keywords": [
    "pi-package",
    "literature-review",
    "systematic-review",
    "prisma",
    "openalex",
    "arxiv",
    "crossref",
    "semantic-scholar",
    "open-access",
    "citations"
  ],
  "files": [
    "index.ts",
    "extensions/",
    "src/",
    "!src/**/*.test.ts",
    "!src/fixtures/",
    "docs/*.md",
    "CITATION.cff"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^26.2.0",
    "typebox": "^1.1.38",
    "typescript": "^7.0.2"
  }
}
