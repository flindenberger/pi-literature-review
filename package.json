{
  "name": "pi-literature-review",
  "version": "0.2.0",
  "description": "Local, open, login-free academic literature tool for Pi or the browser: search paper databases plus code repositories, citation graphs, PRISMA diagrams, answers over your PDFs with page-exact citations. Optimised for local AI models.",
  "type": "module",
  "license": "MIT",
  "author": "Florian Lindenberger",
  "homepage": "https://github.com/flindenberger/pi-literature-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flindenberger/pi-literature-review.git"
  },
  "bugs": {
    "url": "https://github.com/flindenberger/pi-literature-review/issues"
  },
  "keywords": [
    "pi-package",
    "literature-review",
    "systematic-review",
    "prisma",
    "openalex",
    "arxiv",
    "crossref",
    "semantic-scholar",
    "open-access",
    "citations"
  ],
  "bin": {
    "pi-literature-review": "bin/pi-literature-review.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin/",
    "index.ts",
    "extensions/",
    "src/",
    "!src/**/*.test.ts",
    "!src/fixtures/",
    "!src/web/demo/",
    "!src/web/demo-build.ts",
    "docs/*.md",
    "CITATION.cff",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/flindenberger/pi-literature-review/main/docs/img/gallery.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^26.2.0",
    "typebox": "^1.1.38",
    "typescript": "^7.0.2"
  }
}
